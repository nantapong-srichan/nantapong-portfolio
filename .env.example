# ===== Sandbox switch (read this first) =====
# Sandbox = fake slips accepted, OTP shown on screen, dev webhook secret, simulated bank, table launcher.
# ON in `npm run dev` (QRPAY_SANDBOX=0 turns it off), OFF by default in production so a real deploy stays safe.
# The public portfolio is a DEMO with no real money: its production deploy sets DEMO_SANDBOX=1 on purpose.
# NEVER set DEMO_SANDBOX=1 on a deploy that handles real money.
DEMO_SANDBOX=
QRPAY_SANDBOX=

# Thunder API (slip verification). Without a key slips work only in sandbox; otherwise they are rejected as "not configured".
THUNDER_API_KEY=
# Required outside sandbox: digits of your receiving account / PromptPay id (slips to other accounts are rejected)
THUNDER_EXPECT_RECEIVER=

# ThaiBulkSMS OTP. Without keys OTP works only in sandbox (code shown on screen); otherwise /api/otp/request answers 503.
THAIBULKSMS_OTP_KEY=
THAIBULKSMS_OTP_SECRET=

# Incoming-payment webhook HMAC secret (per demo: PAYMENT_WEBHOOK_SECRET_<SCOPE>). Required outside sandbox.
# Signature = hex HMAC-SHA256 of `${scope}.${x-timestamp}.${rawBody}`
PAYMENT_WEBHOOK_SECRET=

# Cafe demo: required in production (signs table tokens); CAFE_DEMO_LAUNCHER=1 shows the table launcher without sandbox
CAFE_TABLE_SECRET=
# Secret signing gym member tokens (required in production, even with DEMO_SANDBOX=1)
GYM_MEMBER_SECRET=
CAFE_DEMO_LAUNCHER=
